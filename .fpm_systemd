-s dir
--name xhttp-box
--category net
--license GPL-3.0-or-later
--description "Independent, unofficial XHTTP transport implementation derived from sing-box."
--url "https://github.com/flyzstu/xhttp-box"
--vendor xhttp-box
--maintainer "flyzstu <flyzstu@gmail.com>"
--deb-field "Bug: https://github.com/flyzstu/xhttp-box/issues"
--no-deb-generate-changes
--config-files /etc/xhttp-box/config.json
--after-install release/config/xhttp-box.postinst

release/config/config.json=/etc/xhttp-box/config.json

release/config/xhttp-box.service=/usr/lib/systemd/system/xhttp-box.service
release/config/xhttp-box@.service=/usr/lib/systemd/system/xhttp-box@.service
release/config/xhttp-box.sysusers=/usr/lib/sysusers.d/xhttp-box.conf
release/config/xhttp-box.rules=usr/share/polkit-1/rules.d/xhttp-box.rules
release/config/xhttp-box-split-dns.xml=/usr/share/dbus-1/system.d/xhttp-box-split-dns.conf

release/completions/xhttp-box.bash=/usr/share/bash-completion/completions/xhttp-box.bash
release/completions/xhttp-box.fish=/usr/share/fish/vendor_completions.d/xhttp-box.fish
release/completions/xhttp-box.zsh=/usr/share/zsh/site-functions/_xhttp-box

LICENSE=/usr/share/licenses/xhttp-box/LICENSE
NOTICE.md=/usr/share/doc/xhttp-box/NOTICE.md
